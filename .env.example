# Vendor Intelligence — environment. Copy to .env and fill in what you need.
# Loaded automatically by vi/env.py at package import. Real shell variables win over this file.

# Anthropic key. Leave blank to run the chat and narration on the offline engine.
ANTHROPIC_API_KEY=

# Model used by the vendor chat and the post-mortem narrator.
VI_ANTHROPIC_MODEL=claude-sonnet-4-5

# Port for `make serve` / `python -m vi.api`. 8000 clashes with Docker's DynamoDB on this machine.
VI_PORT=8010

# SQLite file.
VI_DB=data/vendor_intelligence.db

# Signs the vendor session cookie. Unset = a fresh random key per process (everyone is signed out
# on restart). Set any long random string to keep sessions across restarts.
# VI_SECRET=

# Override only to point at a proxy or a mock API.
# ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages

# --- Slingring (Procol's internal LLM gateway) ---------------------------------
# It speaks both the OpenAI and the Anthropic dialects; this project speaks Anthropic,
# so only these three lines change. Keys are LiteLLM virtual keys and start with sk-.
# ANTHROPIC_API_URL=http://slingring.procol.tech/anthropic/v1/messages
# ANTHROPIC_API_KEY=sk-your-slingring-key
# VI_ANTHROPIC_MODEL=HACK26_GPT_6_ASTRA
